generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  
 
}

enum Role {
  USER
  ADMIN
  MAGAZINIER

}

enum PalletType {
    EPAL_1 
  EPAL_2 
  EPAL_3 
  EPAL_6 
  GMA 
  CUSTOM 
}

enum PalletCertificate {
    EPAL 
  ISPM15
  FSC 
  PEFC 
}
model User{
  id String @id @default(uuid())
  name String 
  surname String
  email String
  password String
  role Role @default(USER)

  address Address?
}

model Address{
  id String @id @default(uuid())

  userId String @unique
  user User @relation(fields: [userId], references: [id])

  City String
}

model Pallet {
  id            String @id @default(uuid())
  name          String
  type          PalletType

  length        Int
  width         Int
  height        Int

  certificates  PalletCertificateOnPallet[]
}

model PalletCertificateOnPallet {
  palletId      String
  certificate   PalletCertificate

  pallet        Pallet @relation(fields: [palletId], references: [id])

  @@id([palletId, certificate])
}